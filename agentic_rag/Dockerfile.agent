
# Sử dụng base image CUDA 12.8 theo yêu cầu phần cứng mới
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

# Thiết lập môi trường không tương tác
ENV DEBIAN_FRONTEND=noninteractive

# Cài đặt Python và Mambaforge
RUN apt-get update && apt-get install -y \
    wget \
    git \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt Mamba (micromamba)
RUN wget -qO- https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba
ENV MAMBA_EXE=/bin/micromamba
ENV MAMBA_ROOT_PREFIX=/opt/conda
ENV PATH=$MAMBA_ROOT_PREFIX/bin:$PATH

# Sao chép file môi trường vào container
COPY agentic_rag/environment.yml /tmp/environment.yml

# Tạo môi trường bằng mamba
RUN $MAMBA_EXE create -f /tmp/environment.yml -y && \
    $MAMBA_EXE clean --all -y

# Thiết lập thư mục làm việc
WORKDIR /app
COPY . /app

# Lệnh chạy chính
CMD ["bash", "-c", "source /opt/conda/bin/activate agentic_rag && python3 agentic_rag/main.py"]

# =============================================================================
# Vietnamese Legal Documents BigData Pipeline — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git (it is listed in .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
ENV=local
DEPLOYMENT_PROFILE=laptop          # laptop | server
PROJECT_NAME=vn-legal-rag
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MinIO / S3-compatible Object Storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme_in_production
MINIO_USE_SSL=false

S3_BUCKET_BRONZE=legal-bronze
S3_BUCKET_SILVER=legal-silver
S3_BUCKET_GOLD=legal-gold
S3_BUCKET_WAREHOUSE=documents
S3_BUCKET_CHECKPOINTS=legal-checkpoints

# ---------------------------------------------------------------------------
# PostgreSQL (Iceberg catalog + application metadata)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=document_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_in_production

ICEBERG_CATALOG=lakehouse
ICEBERG_WAREHOUSE=s3a://documents/warehouse

# ---------------------------------------------------------------------------
# Apache Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=document-extracted-text
KAFKA_TOPIC_DLQ=document-dlq
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ---------------------------------------------------------------------------
# Milvus Vector Database
# ---------------------------------------------------------------------------
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=document_vectors
MILVUS_DIM=1024

# ---------------------------------------------------------------------------
# Embedding Model
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda              # cuda | cpu

# ---------------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------------
OLLAMA_URL=http://heritage_ollama:11434
OLLAMA_MODEL=llama3.2:1b
GEMINI_API_KEY=                    # Your Google AI Studio key (optional)

# ---------------------------------------------------------------------------
# Apache Spark
# ---------------------------------------------------------------------------
SPARK_MASTER=local[*]              # local[*] | spark://spark-master:7077
SPARK_APP_NAME_PREFIX=VNLegal
SPARK_SQL_SHUFFLE_PARTITIONS=8

# ---------------------------------------------------------------------------
# Streaming
# ---------------------------------------------------------------------------
STREAM_TRIGGER_SECONDS=60
STREAM_MAX_OFFSETS_PER_TRIGGER=500
STREAM_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# HuggingFace Dataset
# ---------------------------------------------------------------------------
HF_DATASET_REPO=th1nhng0/vietnamese-legal-documents
HF_TOKEN=                          # Your HuggingFace token (required for download)

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PIPELINE_METRICS_LOG_PATH=./data/metrics/pipeline_metrics.jsonl
MANIFEST_ROOT=./data/manifests
DQ_FAIL_ON_ERROR=true              # Block pipeline on critical DQ failures

# ---------------------------------------------------------------------------
# Local Paths (for laptop/dev profile)
# ---------------------------------------------------------------------------
LOCAL_DATA_ROOT=./data
CHECKPOINT_ROOT=./data/checkpoints
